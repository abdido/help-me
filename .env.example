# PostgreSQL connection
DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk_db?schema=public"

# Frontend URL used in CORS. Set this to the Helpdesk web app origin.
FRONTEND_URL="http://localhost:5174"

# Set only when the API is behind a reverse proxy. List trusted proxy IPs or CIDRs.
TRUSTED_PROXY=""

# SMTP provider for password reset emails (for example, your company email provider).
EMAIL_PASSWORD_RESET_ENABLED=false
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password-or-app-password"
SMTP_FROM="Helpdesk <no-reply@example.com>"
PASSWORD_RESET_URL="http://localhost:5174/reset-password"
